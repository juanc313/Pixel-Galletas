# Copia este archivo como ".env" y completa tus valores reales.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pixel_galletas_api
# BD en la nube (Aiven, PlanetScale…): pon DB_SSL=true y el proveedor te da
# el resto. En local con MySQL Server déjalo en false.
DB_SSL=false
# Ruta al ca.pem del proveedor (opcional si DB_SSL_VERIFY=false).
DB_SSL_CA=
# El mismo certificado como texto, para plataformas sin archivos locales (Vercel).
# Puede ir en una sola línea con \n literales. Si tiene valor, manda sobre DB_SSL_CA.
DB_SSL_CA_PEM=
DB_SSL_VERIFY=true
PORT=3000
# Dominio público del sitio (https://ejemplo.com). Activa /sitemap.xml; vacío = sin sitemap.
SITIO_URL=
# Secreto del cron de Vercel que purga eventos antiguos. Vercel lo envía solo; úsalo
# con cualquier valor largo. Sin él, la ruta de purga no existe.
CRON_SECRET=
# Una frase larga y difícil de adivinar. Sin ella el servidor no inicia y, en
# producción, debe tener al menos 32 caracteres.
JWT_SECRET=
# Número de proxies delante de la app (1 detrás de nginx o Cloudflare), para que los
# límites de tasa cuenten al cliente real. En Vercel no hace falta. Sin proxy, vacío.
TRUST_PROXY=
# Orígenes extra que pueden llamar a la API, separados por comas. El front se sirve
# desde el mismo dominio, así que normalmente va vacío.
ORIGENES_PERMITIDOS=
# Aviso de pedido nuevo al obrador por Telegram (opcional).
# La llave la entrega @BotFather al crear el bot; el chat id se lee en
# https://api.telegram.org/bot<TU_LLAVE>/getUpdates después de escribirle "hola" al bot.
# Con estas dos vacías el sitio funciona igual: el pedido se guarda y el aviso no sale.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Botones del aviso (🔥 al horno, 🎁 listo, 🏆 entregado). Una clave larga inventada
# por ti (24+ caracteres: letras, números, _ o -), igual aquí y en Vercel. Después
# de ponerla en Vercel, corre una vez: npm run telegram-webhook
TELEGRAM_WEBHOOK_SECRET=
# Horas que un pedido puede quedarse quieto antes de que Pixelito lo recuerde
# (de 7:00 a 21:00, máximo 3 veces por etapa). Vacío = 2.
RECORDATORIO_HORAS=
